# Supabase project → Settings → API. Also set the two NEXT_PUBLIC_ values on the
# admin and www Vercel projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `bun db:seed` / `bun db:pull` on your machine. Never put this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
